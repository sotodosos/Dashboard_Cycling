# Copia este fichero a `.env` y rellena tus datos.
# `.env` está en .gitignore: nunca se sube al repositorio.

GARMIN_EMAIL=tu_email@ejemplo.com
GARMIN_PASSWORD=tu_contraseña

# intervals.icu (opcional, recomendado para CTL/ATL/TSB y zonas de potencia)
# Settings → Developer Settings → API key
INTERVALS_API_KEY=tu_api_key
# 0 = el atleta dueño de la API key
INTERVALS_ATHLETE_ID=0

# Opcionales
# GARMIN_DB_PATH=data/garmin.db
# GARMIN_TOKENSTORE=data/tokens.json
# GARMIN_TIMEZONE=Europe/Madrid
# Sincronización automática al abrir el dashboard
# GARMIN_AUTO_SYNC=1
# GARMIN_AUTO_SYNC_TTL_MINUTES=60
# GARMIN_AUTO_SYNC_DAYS=7
# Para validar sin usar credenciales ni sincronizar cuentas reales:
# GARMIN_DEMO=1
